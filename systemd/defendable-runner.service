[Unit]
Description=DefendableCloud Runner (assignment queue)
After=network-online.target
[Service]
Type=simple
User=swarm
EnvironmentFile=/opt/defendableos/node/node.env
ExecStart=/opt/defendableos/bin/defendable-run --watch /opt/defendableos/assignments
Restart=on-failure
RestartSec=15
[Install]
WantedBy=multi-user.target
